{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psp-cdl:document:1.0",
  "title": "PSP Codec Profile 1.0 normalized document",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "profile", "children"],
  "properties": {
    "kind": {"const": "document"},
    "profile": {"const": "PSP-CODEC-1.0"},
    "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "source": {"type": "string"}
  },
  "$defs": {
    "node": {"oneOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/section"}]},
    "text": {
      "type": "object", "additionalProperties": false, "required": ["kind", "value"],
      "properties": {"kind": {"const": "text"}, "value": {"type": "string", "minLength": 1}}
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["kind", "attributes", "children"],
      "properties": {
        "kind": {"const": "section"},
        "attributes": {
          "type": "object", "maxProperties": 256, "required": ["type"],
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$", "not": {"pattern": "[^A-Za-z0-9_.:-]"}},
          "properties": {"type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": {"pattern": "[^a-z0-9-]"}}},
          "additionalProperties": {"type": "string"}
        },
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    }
  }
}
