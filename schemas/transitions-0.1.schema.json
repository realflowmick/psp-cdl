{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp-cdl.org/schemas/transitions-0.1.schema.json",
  "title": "PSP deterministic transition selection 0.1",
  "description": "CC0-1.0. Host-only request; schema validation cannot establish provenance authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "nodeId", "completed", "siblings", "attributes", "transitions", "facts"],
  "properties": {
    "profile": {"const": "PSP-TRANSITIONS-0.1"},
    "nodeId": {"$ref": "#/$defs/id"},
    "completed": {"type": "boolean"},
    "siblings": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
    "transitions": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["target_node"],
      "properties": {
        "target_node": {"$ref": "#/$defs/id"}, "source_node": {"$ref": "#/$defs/id"},
        "condition": {"type": "string", "maxLength": 4096},
        "priority": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
      }
    }},
    "facts": {"type": "object", "maxProperties": 1024, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["value", "origins"],
      "properties": {
        "value": {},
        "origins": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["endpoint", "trustLevel", "priority", "signatureVerified"],
          "properties": {
            "endpoint": {"type": "string", "maxLength": 2048},
            "trustLevel": {"type": "integer", "minimum": 0, "maximum": 5},
            "priority": {"type": "integer", "minimum": 0, "maximum": 100},
            "signatureVerified": {"type": "boolean"}
          }
        }}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$", "maxLength": 128},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "transitionIndex", "sourceNode", "targetNode", "usedFacts"],
      "properties": {
        "profile": {"const": "PSP-TRANSITIONS-0.1"},
        "transitionIndex": {"type": "integer", "minimum": 0, "maximum": 255},
        "sourceNode": {"$ref": "#/$defs/id"}, "targetNode": {"$ref": "#/$defs/id"},
        "usedFacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
