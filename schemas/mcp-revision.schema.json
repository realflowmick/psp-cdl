{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp-cdl.org/schemas/mcp-revision.schema.json",
  "$comment": "CC0-1.0; project draft PSP-MCP-REVISION-0.1, pending review.",
  "$defs": {
    "identifier": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$","not":{"pattern":"[^A-Za-z0-9._:-]"}},
    "digest": {"type":"string","minLength":64,"maxLength":64,"pattern":"^[a-f0-9]{64}$"},
    "catalog": {
      "type":"object","additionalProperties":false,
      "required":["profile","epoch","generation","catalogDigest"],
      "properties": {
        "profile":{"const":"PSP-MCP-REVISION-0.1"},
        "epoch":{"$ref":"#/$defs/identifier"},
        "generation":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "catalogDigest":{"$ref":"#/$defs/digest"}
      }
    },
    "precondition": {
      "type":"object","additionalProperties":false,
      "required":["profile","epoch","generation","catalogDigest","toolRevision","inputDigest"],
      "properties": {
        "profile":{"const":"PSP-MCP-REVISION-0.1"},
        "epoch":{"$ref":"#/$defs/identifier"},
        "generation":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "catalogDigest":{"$ref":"#/$defs/digest"},
        "toolRevision":{"$ref":"#/$defs/identifier"},
        "inputDigest":{"$ref":"#/$defs/digest"}
      }
    }
  }
}
