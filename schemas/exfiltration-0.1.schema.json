{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realflowcloud.org/psp/schemas/exfiltration-0.1.json",
  "title": "PSP-EXFIL-0.1 outbound-text assessment",
  "$comment": "CC0-1.0. Heuristic exfiltration signals for host threat accumulation. Assessments carry counts, ratios, distances, token ranges and keyed section identifiers; they never carry protected or outbound text. A clear disposition is not evidence that nothing leaked.",
  "$ref": "#/$defs/assessment",
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "disposition": {"enum": ["clear", "suspicious", "leak"]},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "optionalText": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]},
    "lexical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "score", "longestRunTokens", "coverage", "runs", "ranges"],
      "properties": {
        "disposition": {"$ref": "#/$defs/disposition"},
        "score": {"$ref": "#/$defs/unit"},
        "longestRunTokens": {"$ref": "#/$defs/count"},
        "coverage": {"$ref": "#/$defs/unit"},
        "runs": {"$ref": "#/$defs/count"},
        "ranges": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "array", "prefixItems": [{"$ref": "#/$defs/count"}, {"$ref": "#/$defs/count"}], "minItems": 2, "maxItems": 2}
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "score", "bestDistance", "strongChunks", "suspiciousChunks", "longestRun"],
      "properties": {
        "disposition": {"$ref": "#/$defs/disposition"},
        "score": {"$ref": "#/$defs/unit"},
        "bestDistance": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 2}, {"type": "null"}]},
        "strongChunks": {"$ref": "#/$defs/count"},
        "suspiciousChunks": {"$ref": "#/$defs/count"},
        "longestRun": {"$ref": "#/$defs/count"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "sectionType", "sessionId", "version", "label", "tokens", "chunks", "disposition", "signal", "lexical", "semantic"],
      "properties": {
        "sectionId": {"$ref": "#/$defs/digest"},
        "sectionType": {"enum": ["system", "context"]},
        "sessionId": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
        "version": {"$ref": "#/$defs/optionalText"},
        "label": {"$ref": "#/$defs/optionalText"},
        "tokens": {"$ref": "#/$defs/count"},
        "chunks": {"$ref": "#/$defs/count"},
        "disposition": {"enum": ["suspicious", "leak"]},
        "signal": {"$ref": "#/$defs/unit"},
        "lexical": {"$ref": "#/$defs/lexical"},
        "semantic": {"anyOf": [{"$ref": "#/$defs/semantic"}, {"type": "null"}]}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "application", "embedder", "vector", "disposition", "signal", "sources", "flags", "complete", "output", "sections"],
      "properties": {
        "profile": {"const": "PSP-EXFIL-0.1"},
        "application": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "embedder": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
        "vector": {"enum": ["portable", "sqlite-vec", null]},
        "disposition": {"$ref": "#/$defs/disposition"},
        "signal": {"$ref": "#/$defs/unit"},
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern_match", "external_classifier"],
          "properties": {
            "pattern_match": {"$ref": "#/$defs/unit"},
            "external_classifier": {"anyOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]}
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["assessment_incomplete", "context_disclosure", "protected_content_overlap", "system_prompt_disclosure"]}
        },
        "complete": {"type": "boolean"},
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "chunks"],
          "properties": {"tokens": {"$ref": "#/$defs/count"}, "chunks": {"$ref": "#/$defs/count"}}
        },
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "protectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "created", "tokens", "shingles", "chunks"],
      "properties": {
        "sectionId": {"$ref": "#/$defs/digest"},
        "created": {"type": "boolean"},
        "tokens": {"$ref": "#/$defs/count"},
        "shingles": {"$ref": "#/$defs/count"},
        "chunks": {"$ref": "#/$defs/count"}
      }
    }
  }
}
