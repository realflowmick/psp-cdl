{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psp:schema:signature-envelope:2.0",
  "title": "PSP Signature Profile 2.0 envelope",
  "$comment": "Structural validation only. Enforce duplicate-name detection, JCS admissibility, canonical base64url/length, expires > timestamp, crypto, key authority and scope separately.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "signature": {
          "$ref": "#/$defs/signatureObject"
        },
        "data": {}
      },
      "required": [
        "signature",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "signature": {
                "properties": {
                  "contentType": {
                    "const": "text"
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "x-signature": {
          "$ref": "#/$defs/signatureObject"
        },
        "x-data": {}
      },
      "required": [
        "x-signature",
        "x-data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "x-signature": {
                "properties": {
                  "contentType": {
                    "const": "text"
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "x-data": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "x-data": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "signatureObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "algorithm": {
          "enum": [
            "ed25519",
            "hmac-sha256"
          ]
        },
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "secretId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "string",
          "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "signatureVersion": {
          "const": "2.0"
        },
        "sectionType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "contentType": {
          "enum": [
            "text",
            "json"
          ]
        },
        "trustLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "signature",
                "value",
                "signature-algorithm",
                "algorithm",
                "signature-version",
                "signatureVersion",
                "kid",
                "secret-id",
                "secretId",
                "timestamp",
                "expires",
                "version",
                "trust-level",
                "trustLevel",
                "priority",
                "type",
                "sectionType",
                "content-type",
                "contentType",
                "attributes"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "value",
        "algorithm",
        "timestamp",
        "expires",
        "version",
        "signatureVersion",
        "sectionType",
        "contentType"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "ed25519"
              }
            }
          },
          "then": {
            "required": [
              "kid"
            ],
            "not": {
              "required": [
                "secretId"
              ]
            }
          },
          "else": {
            "required": [
              "secretId"
            ],
            "not": {
              "required": [
                "kid"
              ]
            }
          }
        }
      ]
    }
  }
}
