{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realflowcloud.org/psp/schemas/redirect-turns-0.1.json",
  "title": "PSP LLM Redirect 0.1 private commit command",
  "$comment": "CC0-1.0. Explicit redirect store opt-in. Same-owner distinct target node, live expiry, full-write authorization and atomic CAS enforced separately.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "output": {
      "type": "object",
      "required": [
        "text",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "required": [
            "profile",
            "providerId",
            "providerRevision",
            "outputDigest",
            "trustLevel",
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "profile": {
              "const": "PSP-LLM-LOOP-0.1"
            },
            "providerId": {
              "$ref": "#/$defs/id"
            },
            "providerRevision": {
              "$ref": "#/$defs/id"
            },
            "outputDigest": {
              "$ref": "#/$defs/digest"
            },
            "trustLevel": {
              "const": 5
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        }
      }
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^mcp://[a-z0-9]+(?:[.-][a-z0-9]+)*/applications/[A-Za-z0-9][A-Za-z0-9_-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "nodeId",
        "nodeVersion",
        "policyVersion",
        "expiresAt"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "nodeVersion": {
          "$ref": "#/$defs/id"
        },
        "policyVersion": {
          "$ref": "#/$defs/id"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "type": "object",
  "required": [
    "action",
    "requestId",
    "sessionId",
    "expectedVersion",
    "nodeId",
    "nodeVersion",
    "policyVersion",
    "state",
    "inputDigest",
    "output",
    "retained",
    "complete",
    "postCompletion",
    "redirect"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "commitRedirectTurn"
    },
    "requestId": {
      "$ref": "#/$defs/id"
    },
    "sessionId": {
      "$ref": "#/$defs/uuid"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nodeId": {
      "$ref": "#/$defs/id"
    },
    "nodeVersion": {
      "$ref": "#/$defs/id"
    },
    "policyVersion": {
      "$ref": "#/$defs/id"
    },
    "state": {
      "type": "object"
    },
    "inputDigest": {
      "$ref": "#/$defs/digest"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "retained": {
      "type": "object"
    },
    "complete": {
      "type": "boolean"
    },
    "postCompletion": {
      "const": "redirect"
    },
    "redirect": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/redirect"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "redirect": {
            "$ref": "#/$defs/redirect"
          }
        }
      },
      "else": {
        "properties": {
          "redirect": {
            "type": "null"
          }
        }
      }
    }
  ]
}
