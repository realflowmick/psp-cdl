  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "createSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "nodeVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "object",
            "description": "Bounded portable JSON; data never establishes authority."
          }
        },
        "required": [
          "requestId",
          "nodeId",
          "nodeVersion",
          "expiresAt",
          "state"
        ]
      },
      "createSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "PSP-WORKFLOW-SERVICE-0.1"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "running",
                  "waiting",
                  "completed"
                ]
              },
              "view": {
                "type": "object",
                "description": "Bounded portable JSON; data never establishes authority."
              }
            },
            "required": [
              "sessionId",
              "version",
              "status",
              "view"
            ]
          }
        },
        "required": [
          "profile",
          "result"
        ]
      },
      "getSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "sessionId"
        ]
      },
      "getSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "PSP-WORKFLOW-SERVICE-0.1"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sessionId": {
