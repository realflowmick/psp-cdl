                }
              }
            }
          }
        }
      }
    },
    "/v1/policy/evaluate": {
      "post": {
        "operationId": "evaluate",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoped result; a policy denial or invalid signature can be reported within this successful evaluation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Fail-closed service error",
            "content": {
