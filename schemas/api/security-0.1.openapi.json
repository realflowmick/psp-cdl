  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque host-validated token. The host owns tenant, subject, scopes, expiry and revocation."
      }
    },
    "schemas": {
      "VerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "not": {
                    "pattern": "[^A-Za-z0-9._:-]"
                  }
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "content"
              ]
            }
          }
        },
        "required": [
          "operation_id",
          "sections"
        ]
      },
      "EvaluateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          }
        },
        "required": [
          "operation_id"
        ]
      },
      "VerifyResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "PSP-SERVICE-0.1"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "not": {
                        "pattern": "[^A-Za-z0-9._:-]"
                      }
                    },
                    "valid": {
                      "const": true
                    },
                    "signature_algorithm": {
                      "enum": [
                        "ed25519",
                        "hmac-sha256"
                      ]
                    },
                    "trust_level": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "priority": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "expires": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "valid",
                    "signature_algorithm",
                    "trust_level",
                    "priority",
                    "expires"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                      "not": {
                        "pattern": "[^A-Za-z0-9._:-]"
                      }
                    },
                    "valid": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "valid",
                    "error"
                  ]
                }
              ]
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "valid": {
                "type": "integer",
                "minimum": 0
              },
              "invalid": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "total",
              "valid",
              "invalid"
            ]
          }
        },
        "required": [
          "profile",
          "operation_id",
          "policy_version",
          "results",
          "summary"
        ]
      },
      "EvaluateResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "PSP-SERVICE-0.1"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "decision": {
            "enum": [
              "allow",
              "deny",
              "unsupported"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "profile",
          "operation_id",
          "policy_version",
          "decision",
          "reasonCodes"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
