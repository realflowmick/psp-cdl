                }
              }
            }
          },
          "409": {
            "description": "Fail-closed service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Fail-closed service error",
            "content": {
              "application/json": {
