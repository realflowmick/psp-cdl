{
  "openapi": "3.1.0",
  "info": {
    "title": "PSP reference security service (draft)",
    "version": "0.1.0",
    "description": "PSP-SERVICE-0.1; project-owned draft, not the missing RFC-PSP-API. Read-only operations; no workflow authorization ticket."
  },
  "paths": {
    "/v1/security/verify": {
      "post": {
        "operationId": "verify",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoped result; a policy denial or invalid signature can be reported within this successful evaluation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Fail-closed service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
