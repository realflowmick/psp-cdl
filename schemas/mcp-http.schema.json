{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp-cdl.org/schemas/mcp-http-0.1.json",
  "$comment": "CC0-1.0. PSP-MCP-HTTP-0.1 draft trusted host configuration, not model-visible tool arguments. Credential callbacks are deliberately excluded.",
  "$ref": "#/$defs/peerConfig",
  "$defs": {
    "peerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "allowLoopbackHttp",
        "serverInfo",
        "timeoutMs"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Exact canonical HTTPS resource URL; no userinfo, query, fragment or model substitution. Runtime additionally validates TLS/loopback rules."
        },
        "allowLoopbackHttp": {
          "type": "boolean"
        },
        "serverInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "caPem": {
          "type": "string"
        },
        "revisionProfile": {
          "const": "PSP-MCP-REVISION-0.1"
        }
      }
    },
    "serverConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "allowLoopbackHttp",
        "authorizationServers",
        "maxSessions",
        "sessionTtlMs",
        "callTimeoutMs"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Exact canonical HTTPS resource URL; no userinfo, query, fragment or model substitution. Runtime additionally validates TLS/loopback rules."
        },
        "allowLoopbackHttp": {
          "type": "boolean"
        },
        "authorizationServers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "sessionTtlMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "callTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      }
    }
  }
}
