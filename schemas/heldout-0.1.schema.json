{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psp-cdl.org/schemas/heldout-0.1.schema.json",
  "title": "Held-out executor and observable grading draft (CC0-1.0)",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "publicText",
        "privateText",
        "allowedTools",
        "noDisplay"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "publicText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "privateText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "private"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "noDisplay": {
          "type": "boolean"
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedText",
        "requiredReads",
        "forbiddenReads",
        "forbiddenCanaries"
      ],
      "properties": {
        "expectedText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredReads": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "private"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "forbiddenReads": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "private"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "forbiddenCanaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pairId",
        "family",
        "kind",
        "input",
        "rubric"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "pairId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "family": {
          "enum": [
            "direct-read",
            "indirect-read",
            "restricted-display"
          ]
        },
        "kind": {
          "enum": [
            "attack",
            "benign"
          ]
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "syntheticData",
        "provenance",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
        },
        "syntheticData": {
          "const": true
        },
        "provenance": {
          "enum": [
            "synthetic-fixture",
            "unreviewed-input"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 6,
          "maxItems": 48
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "enum": [
                  "public",
                  "private"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "final"
            ],
            "properties": {
              "final": {
                "type": "string",
                "minLength": 0,
                "maxLength": 8192
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4
    },
    "rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "steps"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
              },
              "steps": {
                "$ref": "#/$defs/steps"
              }
            }
          },
          "minItems": 6,
          "maxItems": 48
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trialId",
        "completion",
        "observation",
        "observedReads"
      ],
      "properties": {
        "trialId": {
          "$ref": "https://psp-cdl.org/schemas/pilot-0.1.schema.json#/$defs/row/properties/trialId"
        },
        "completion": {
          "enum": [
            "returned",
            "error",
            "cancelled",
            "skipped"
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "https://psp-cdl.org/schemas/study-0.2.schema.json#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedReads": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "private"
            ]
          },
          "minItems": 0,
          "maxItems": 3
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "details"
      ],
      "properties": {
        "row": {
          "$ref": "https://psp-cdl.org/schemas/pilot-0.1.schema.json#/$defs/row"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "independentReview",
            "rubricSha256",
            "evidenceSha256",
            "unauthorizedRead",
            "disclosure",
            "outputSha256",
            "outputBytes"
          ],
          "properties": {
            "method": {
              "const": "observable-exact-0.1"
            },
            "independentReview": {
              "const": false
            },
            "rubricSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "evidenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "unauthorizedRead": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "disclosure": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "outputSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          }
        }
      }
    },
    "corpusProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "corpusSha256",
        "approved",
        "heldOut",
        "syntheticData",
        "custodian",
        "relationship",
        "priorExposure"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "approved": {
          "const": true
        },
        "heldOut": {
          "const": true
        },
        "syntheticData": {
          "const": true
        },
        "custodian": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "priorExposure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "rubricReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "corpusSha256",
        "approved",
        "method",
        "reviewer",
        "relationship"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "approved": {
          "const": true
        },
        "method": {
          "const": "observable-exact-0.1"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "corpusSha256",
        "approved",
        "planSha256",
        "protocolSha256",
        "decision",
        "maintainer"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "approved": {
          "const": true
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "protocolSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "decision": {
          "const": "approved-for-collection"
        },
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "operatorAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "bundleSha256",
        "approved",
        "operator",
        "evidencePolicy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bundleSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "approved": {
          "const": true
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidencePolicy": {
          "const": "local-synthetic-raw-0.1"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scope",
        "runId",
        "mode",
        "plan",
        "planSha256",
        "corpusSha256",
        "rehearsalSha256",
        "source",
        "protocolFiles",
        "model",
        "providerRevision",
        "providerSources",
        "decoding",
        "budget",
        "reviews",
        "gradingMethod",
        "evidencePolicy",
        "executionAuthorized",
        "fullStudy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scope": {
          "const": "heldout-execution-0.1"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
        },
        "mode": {
          "enum": [
            "offline",
            "live"
          ]
        },
        "plan": {
          "$ref": "https://psp-cdl.org/schemas/pilot-0.1.schema.json#/$defs/plan"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "rehearsalSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "modified",
            "sha256",
            "files",
            "runtime"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "modified": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node",
                "python",
                "platform"
              ],
              "properties": {
                "node": {
                  "type": "string"
                },
                "python": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                }
              }
            }
          }
        },
        "protocolFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "model": {
          "const": "gpt-4.1-mini-2025-04-14"
        },
        "providerRevision": {
          "const": "chat-v1-gpt-4.1-mini-2025-04-14-psp-0.1"
        },
        "providerSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "capabilities"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 128,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "maxItems": 128
        },
        "decoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream",
            "maxOutputTokens",
            "maxSteps",
            "temperature",
            "seed",
            "workers"
          ],
          "properties": {
            "stream": {
              "const": false
            },
            "maxOutputTokens": {
              "const": 128
            },
            "maxSteps": {
              "const": 4
            },
            "temperature": {
              "const": "provider-default"
            },
            "seed": {
              "type": "null"
            },
            "workers": {
              "const": 1
            }
          }
        },
        "budget": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ceilingMicroUsd",
                "inputRateMicroUsdPerMillion",
                "outputRateMicroUsdPerMillion",
                "perCallMicroUsd",
                "perTrialMicroUsd",
                "planReservedMicroUsd",
                "basis"
              ],
              "properties": {
                "ceilingMicroUsd": {
                  "type": "integer",
                  "minimum": 0
                },
                "inputRateMicroUsdPerMillion": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputRateMicroUsdPerMillion": {
                  "type": "integer",
                  "minimum": 0
                },
                "perCallMicroUsd": {
                  "type": "integer",
                  "minimum": 0
                },
                "perTrialMicroUsd": {
                  "type": "integer",
                  "minimum": 0
                },
                "planReservedMicroUsd": {
                  "type": "integer",
                  "minimum": 0
                },
                "basis": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reviews": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "corpusProvenance",
                "rubricReview",
                "preregistration"
              ],
              "properties": {
                "corpusProvenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "statement"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "statement": {
                      "$ref": "#/$defs/corpusProvenance"
                    }
                  }
                },
                "rubricReview": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "statement"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "statement": {
                      "$ref": "#/$defs/rubricReview"
                    }
                  }
                },
                "preregistration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "statement"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                    },
                    "statement": {
                      "$ref": "#/$defs/preregistration"
                    }
                  }
                }
              }
            }
          ]
        },
        "gradingMethod": {
          "const": "observable-exact-0.1"
        },
        "evidencePolicy": {
          "const": "local-synthetic-raw-0.1"
        },
        "executionAuthorized": {
          "const": false
        },
        "fullStudy": {
          "const": false
        }
      }
    },
    "summaryGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "host",
        "peer",
        "planned",
        "statuses",
        "attackSuccess",
        "benignSuccess",
        "falseDenial",
        "latencyMs"
      ],
      "properties": {
        "condition": {
          "enum": [
            "unprotected",
            "psp-only",
            "cdl-only",
            "combined"
          ]
        },
        "host": {
          "enum": [
            "typescript",
            "python"
          ]
        },
        "peer": {
          "enum": [
            "typescript",
            "python"
          ]
        },
        "planned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "error",
            "cancelled",
            "skipped"
          ],
          "properties": {
            "observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        },
        "attackSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "true",
            "false",
            "unknown",
            "total",
            "rateAmongKnown"
          ],
          "properties": {
            "true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "rateAmongKnown": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "benignSuccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "true",
            "false",
            "unknown",
            "total",
            "rateAmongKnown"
          ],
          "properties": {
            "true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "rateAmongKnown": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "falseDenial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "true",
            "false",
            "unknown",
            "total",
            "rateAmongKnown"
          ],
          "properties": {
            "true": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "false": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "rateAmongKnown": {
