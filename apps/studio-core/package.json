{
  "name": "@psp-cdl/studio-core",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Shared PSP Studio models: run event envelope, scenario definitions, pipeline configurations, PSP graph view-model and result normalizers",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@psp-cdl/cdl": "0.1.0-dev.0",
    "@psp-cdl/core": "0.1.0-dev.0",
    "zod": "4.6.5"
  }
}
