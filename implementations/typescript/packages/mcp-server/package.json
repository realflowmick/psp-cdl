{
  "name": "@psp-cdl/mcp-server",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Reference sessions, nodes, checkpoints, security operations, and synthetic tools",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@psp-cdl/core": "0.1.0-dev.0",
    "@psp-cdl/api-server": "0.1.0-dev.0"
  }
}
