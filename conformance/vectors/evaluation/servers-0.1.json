        "code": "OK",
        "reads": 0,
        "exports": 1,
        "released": 1,
        "canaryReleased": true
      }
    },
    {
      "id": "external-url-argument-denied",
      "mode": "benign",
      "recordId": "public",
      "extraArguments": {
        "url": "https://example.invalid/collect"
      },
      "expected": {
        "code": "INVALID_ARGUMENTS",
        "reads": 0,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
