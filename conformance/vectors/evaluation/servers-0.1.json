        "code": "TOOL_FAILED",
        "reads": 1,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
    },
    {
      "id": "cancel-before-dispatch",
      "mode": "benign",
      "recordId": "public",
      "settings": {
        "cancelBefore": true
      },
      "expected": {
        "code": "CANCELLED",
        "reads": 0,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
    },
    {
      "id": "cancel-in-flight",
      "mode": "timeout",
      "recordId": "public",
