        "reads": 0,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
    },
    {
      "id": "malformed-output",
      "mode": "malformed",
      "recordId": "public",
      "expected": {
        "code": "INVALID_OUTPUT",
        "reads": 1,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
    },
    {
      "id": "oversized-output",
      "mode": "oversize",
      "recordId": "public",
      "expected": {
        "code": "TOOL_FAILED",
        "reads": 1,
        "exports": 0,
        "released": 0,
        "canaryReleased": false
      }
    },
    {
      "id": "hung-tool-timeout",
      "mode": "timeout",
