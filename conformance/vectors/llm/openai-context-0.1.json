  "cases": [
    {
      "id": "context-text-preserved",
      "scope": "adapter",
      "settings": {
        "request": {
          "messages": [
            {
              "role": "system",
              "content": "Synthetic SYSTEM."
            },
            {
              "role": "user",
              "content": "Read synthetic data 🧪."
            },
            {
              "role": "user",
              "content": "{\"event\":\"session-view\",\"state\":{\"current_node\":\"entry\"}}"
            },
            {
              "role": "assistant",
              "content": "{\"type\":\"service\",\"operation\":\"updateSession\"}"
            },
            {
              "role": "user",
              "content": "{\"event\":\"service-denied\",\"code\":\"AUTHORIZATION_DENIED\"}"
            }
          ],
          "tools": [
            {
              "name": "echo.read",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "additionalProperties": false
              },
              "outputSchema": {
                "type": "object"
              }
            }
          ]
        },
        "config": {
          "transcriptProfile": "PSP-OPENAI-CONTEXT-0.1"
        }
      },
      "expected": {
        "code": "OK",
        "transportCalls": 1,
        "released": 1,
        "toolCalls": 0
      }
    },
